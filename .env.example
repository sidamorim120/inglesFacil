# Variáveis de Ambiente de Exemplo - Inglês Fácil
# Copie este arquivo para .env.local e preencha caso vá conectar a uma instância de produção

# Modo de Execução: 'demo' para modo interativo local (sem backend obrigatório) ou 'production'
VITE_APP_MODE=demo

# Supabase / PostgreSQL (Necessário apenas para transição de produção)
# Obtenha estas chaves no painel do Supabase do seu projeto
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Configurações do Aplicativo
VITE_DEFAULT_TIMEZONE=America/Sao_Paulo
VITE_APP_NAME="Inglês Fácil"
